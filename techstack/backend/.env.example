# MemWault Backend — example environment file
#
# Copy to .env and edit. EVERY variable must keep the MEMWAULT_ prefix:
# app/config.py sets `env_prefix = "MEMWAULT_"`, so an unprefixed name such as
# POSTGRES_USER is ignored entirely and the code default is used instead.
#
# Only the variables for the database and storage engine you actually select
# need to be filled in.

# ── App ──────────────────────────────────────────────────
MEMWAULT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
MEMWAULT_DEBUG=true

# ── Database (sqlite | postgres) ─────────────────────────
MEMWAULT_DATABASE_TYPE=sqlite
# Only used when MEMWAULT_DATABASE_TYPE=postgres:
MEMWAULT_POSTGRES_USER=memwault
MEMWAULT_POSTGRES_PASSWORD=memwault_dev_password
MEMWAULT_POSTGRES_DB=memwault
MEMWAULT_POSTGRES_HOST=localhost
MEMWAULT_POSTGRES_PORT=5432

# ── Redis / Celery ───────────────────────────────────────
MEMWAULT_REDIS_URL=redis://localhost:6379/0
# true runs scrape tasks inline in the API process, so no Redis or Celery
# worker is required for local development.
MEMWAULT_CELERY_ALWAYS_EAGER=true

# ── Storage (local | s3) ─────────────────────────────────
MEMWAULT_STORAGE_TYPE=local
# Relative paths resolve against the backend's working directory, so prefer an
# absolute path if you start uvicorn from somewhere other than techstack/backend.
MEMWAULT_STORAGE_LOCAL_DIR=data/media
# Only used when MEMWAULT_STORAGE_TYPE=s3:
MEMWAULT_S3_ENDPOINT_URL=http://localhost:9000
MEMWAULT_S3_ACCESS_KEY=minioadmin
MEMWAULT_S3_SECRET_KEY=minioadmin
MEMWAULT_S3_BUCKET_NAME=memwault-media
MEMWAULT_S3_REGION=us-east-1

# ── Instagram (your own account) ─────────────────────────
# Optional: the browser login flow in Settings is the recommended route.
MEMWAULT_INSTAGRAM_USERNAME=
MEMWAULT_INSTAGRAM_PASSWORD=

# ── Spotify (optional, music metadata enrichment) ────────
MEMWAULT_SPOTIFY_CLIENT_ID=
MEMWAULT_SPOTIFY_CLIENT_SECRET=

# ── Polling ──────────────────────────────────────────────
MEMWAULT_STORY_POLL_INTERVAL_MINUTES=15

# ── JWT ──────────────────────────────────────────────────
MEMWAULT_JWT_ALGORITHM=HS256
MEMWAULT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
